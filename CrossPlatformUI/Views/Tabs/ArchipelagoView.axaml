<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CrossPlatformUI.ViewModels"
             xmlns:lang="clr-namespace:Z2Randomizer.CrossPlatformUI.Lang"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="450"
             x:DataType="vm:MainViewModel"
             x:Class="CrossPlatformUI.Views.Tabs.ArchipelagoView">
    <Grid ColumnDefinitions="*, *">
        <StackPanel Grid.Column="0">
            <CheckBox
                Margin="14 8 4 0"
                IsChecked="{Binding Config.ArchipelagoMode}"
                Content="Archipelago Mode"
            >
                <ToolTip.Tip><TextBlock Text="{x:Static lang:Resources.ArchipelagoModeToolTip}"/></ToolTip.Tip>
            </CheckBox>
            <TextBox
                Margin="44 0 17 4"
                Text="{Binding Config.ArchipelagoSlotName}"
                IsVisible="{Binding Config.ArchipelagoMode}"
                MaxLength="16"
                PlaceholderText="Slot name"
            >
                <ToolTip.Tip><TextBlock Text="{x:Static lang:Resources.ArchipelagoSlotNameToolTip}"/></ToolTip.Tip>
            </TextBox>
            <CheckBox
                Margin="14 0 4 0"
                IsChecked="{Binding Config.GenerateRequirementGraph}"
                Content="Generate Requirements Graph"
            >
                <ToolTip.Tip><TextBlock Text="{x:Static lang:Resources.GenerateRequirementGraphToolTip}"/></ToolTip.Tip>
            </CheckBox>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBlock
                Margin="14 8 4 0"
                FontWeight="SemiBold"
                Text="Shuffled into Archipelago"
            >
                <ToolTip.Tip><TextBlock Text="{x:Static lang:Resources.ArchipelagoShuffleOptionsToolTip}"/></ToolTip.Tip>
            </TextBlock>
            <TextBlock
                Margin="14 0 4 4"
                FontSize="12"
                Opacity="0.7"
                TextWrapping="Wrap"
                Text="Set on the Items tab. Anything left out is placed by the randomizer and is not a location."
            />
            <CheckBox
                Margin="14 0 4 0"
                IsHitTestVisible="False"
                IsTabStop="False"
                IsThreeState="True"
                IsChecked="{Binding Config.IncludeSpellsInShuffle, Mode=OneWay}"
                Content="Spells (town wizards)"
            />
            <CheckBox
                Margin="14 0 4 0"
                IsHitTestVisible="False"
                IsTabStop="False"
                IsThreeState="True"
                IsChecked="{Binding Config.IncludeSwordTechsInShuffle, Mode=OneWay}"
                Content="Sword techniques"
            />
            <CheckBox
                Margin="14 0 4 0"
                IsHitTestVisible="False"
                IsTabStop="False"
                IsThreeState="True"
                IsChecked="{Binding Config.IncludeQuestItemsInShuffle, Mode=OneWay}"
                Content="Town quest items (water, mirror, Bagu's note)"
            />
        </StackPanel>
    </Grid>
</UserControl>
